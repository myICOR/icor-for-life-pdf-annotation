{
  "name": "icor-for-life-pdf-annotation",
  "version": "0.1.3",
  "private": true,
  "description": "ICOR for Life - PDF Annotation - highlights on a PDF that are notes in the vault, with deep links, canvas cards and a sidebar.",
  "license": "LicenseRef-ICOR-Source-Available-1.0",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src styles.css",
    "pretest": "node test/build.mjs",
    "test": "node --test test/*.test.mjs",
    "gate": "npm run typecheck && npm run build && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.13.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.69.0"
  }
}
